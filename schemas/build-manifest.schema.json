{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/build-manifest.schema.json",
  "title": "Build Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "buildId", "toolVersion", "buildTimestamp", "inputs", "outputs", "counts", "deterministic"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "buildId": { "type": "string", "minLength": 1 },
    "toolVersion": { "type": "string", "minLength": 1 },
    "buildTimestamp": { "type": "string", "format": "date-time" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lexicalRecords", "documents", "tokens", "candidates", "duplicates", "conflicts"],
      "properties": {
        "lexicalRecords": { "type": "integer", "minimum": 0 },
        "documents": { "type": "integer", "minimum": 0 },
        "tokens": { "type": "integer", "minimum": 0 },
        "candidates": { "type": "integer", "minimum": 0 },
        "duplicates": { "type": "integer", "minimum": 0 },
        "conflicts": { "type": "integer", "minimum": 0 }
      }
    },
    "deterministic": { "const": true }
  }
}
