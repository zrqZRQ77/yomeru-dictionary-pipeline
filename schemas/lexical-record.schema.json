{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/lexical-record.schema.json",
  "title": "Lexical Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "primaryForm", "primaryReading", "writtenForms", "readings", "partOfSpeech", "senses", "keys", "sourceRefs", "transformations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "primaryForm": { "type": "string", "minLength": 1 },
    "primaryReading": { "type": "string", "minLength": 1 },
    "writtenForms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "readings": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "partOfSpeech": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "senses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["glosses"],
        "properties": {
          "glosses": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
          "languages": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["forms", "readings", "formReading"],
      "properties": {
        "forms": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "readings": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "formReading": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
      }
    },
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "sourceRecordId"],
        "properties": {
          "sourceId": { "type": "string", "minLength": 1 },
          "sourceRecordId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "transformations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
