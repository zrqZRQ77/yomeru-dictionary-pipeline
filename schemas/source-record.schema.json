{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/source-record.schema.json",
  "title": "Source Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "organization", "url", "version", "retrievedAt", "license", "usage", "transformations"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "organization": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "version": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string", "format": "date" },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "url", "attribution", "redistributionAllowed", "shareAlike"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "attribution": { "type": "string" },
        "redistributionAllowed": { "type": "boolean" },
        "shareAlike": { "type": "boolean" }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "notes"],
      "properties": {
        "mode": { "enum": ["fixture", "evidence", "candidate", "redistributed"] },
        "notes": { "type": "string" }
      }
    },
    "transformations": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
